 pdfplumber/utils/geometry.py | 83 +++++++++++++++++++++++++++++++++++-
 tests/test_utils.py          | 79 ++++++++++++++++++++++++++++++++++
 3 files changed, 162 insertions(+), 2 deletions(-)

