# Engineering OS — runtime environment (packaged deployment)
#
# This file documents every key understood by the packaged service. At package
# install, postinst generates /etc/eos/eos.env (if absent) with sane defaults
# and a randomized NEXTAUTH_SECRET; this example explains each key.
#
# systemd loads the runtime file via EnvironmentFile= (see
# packaging/systemd/eos.service). Apply changes with:
#
#   sudo systemctl restart eos
#
# IMPORTANT: systemd EnvironmentFile values are RAW — no quotes, no shell
# expansion. Lines starting with # are comments.

# --- Database -----------------------------------------------------------------
# SQLite file used by the Prisma client. The package seeds this file (schema
# only, no data) on FIRST install; upgrades never touch it.
# Production target is PostgreSQL via the same Prisma schema (ADR-0003) —
# point DATABASE_URL at your postgres DSN and restart the service.
DATABASE_URL=file:/var/lib/engineering-os/custom.db

# --- NextAuth (Phase-6 credentials auth) ---------------------------------------
# Signs the JWT session cookies. Generate a real secret with:
#   openssl rand -base64 32
# The generated /etc/eos/eos.env already contains a random one; rotate it if
# this example file ever becomes the live config.
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# Canonical base URL of the deployment (used to build callback URLs).
NEXTAUTH_URL=http://localhost:3000

# --- Engine adapters -----------------------------------------------------------
# Python interpreter that hosts the engineering engines (cadquery,
# IfcOpenShell, gmsh, pandapower, simpy, …). The engines themselves are NOT
# bundled with the package — the product honestly probes and reports what is
# installed. `python3` (no engine libs) yields working detection with every
# engine reported not-installed; install the engine libraries into a venv
# and point EOS_PYTHON at its interpreter for real derivations.
# Optional helper: /opt/engineering-os/scripts/setup-engine-libs.sh extracts
# the libGLU/libOpenGL runtimes some engines need.
EOS_PYTHON=python3

# --- Artifact content store ------------------------------------------------------
# Root of the content-addressed store (<projectId>/<artifactId>/<revisionId>).
# Defaults to <WorkingDirectory>/data/artifacts when unset — the package pins
# it under /var/lib so /opt/engineering-os stays free of mutable data and the
# upgrade/retention story stays simple (everything operator-owned lives in
# /var/lib/engineering-os).
EOS_STORAGE_ROOT=/var/lib/engineering-os/artifacts

# --- Scheduled orphan sweep (optional) -------------------------------------------
# The daily eos-orphan-sweep.timer runs
# /opt/engineering-os/bin/orphan-sweep.sh, which calls the ADMIN storage APIs
# (scan + confirm-gated cleanup) through the local HTTP API. Those routes
# require a signed-in session and there is no API-token system, so the sweep
# signs in via the NextAuth credentials flow with the account configured
# here. The account MUST have the admin role (viewer is read-only; engineer
# cannot call admin routes). Use a dedicated service account, not a human one.
# Until both lines are uncommented and set, the sweep logs a skip note and
# exits 0 — no admin call is ever made without credentials.
# EOS_SWEEP_EMAIL=sweep@eos.local
# EOS_SWEEP_PASSWORD=raw-password-no-quotes
