# Engineering OS — environment configuration
#
# PostgreSQL is the production target database (see docs/adr/0003-data-and-storage.md).
# The Phase-1 development backend is SQLite behind the same Prisma schema.
# Copy this file to `.env` before running.

# SQLite (Phase-1 dev). Path is relative to prisma/schema.prisma.
DATABASE_URL="file:../db/custom.db"

# PostgreSQL (production target, schema-compatible — not yet verified end-to-end):
# DATABASE_URL="postgresql://eos:eos@localhost:5432/engineering_os"

# Artifact content store root (defaults to <repo>/data/artifacts)
# EOS_STORAGE_ROOT="/var/lib/engineering-os/artifacts"

# NextAuth (Phase-6 auth slice, contract §1.2). NEXTAUTH_SECRET signs the JWT
# session cookies — generate a real one per install:
#   openssl rand -base64 32
# (the placeholder below only works for a throwaway local dev DB)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Python interpreter hosting the engineering engines (cadquery, IfcOpenShell,
# gmsh, pandapower, SimPy — see docs/02-engines/engine-inventory.md). Absolute
# venv paths are supported (Phase-6 probe fix); bare names resolve via PATH.
# Install the engines with `uv pip install --python <this-python> cadquery ifcopenshell gmsh pandapower simpy`.
EOS_PYTHON=/home/z/.venv/bin/python
